  "macros": [
    {
      "name": "difference_in_differences",
      "path": "macros/difference_in_differences.sql",
      "description": "Two-period difference-in-differences contrast. Identification needs separate design checks.",
      "arguments": [
        "treated_pre",
        "treated_post",
        "comparison_pre",
        "comparison_post"
      ],
      "sql": "{% macro difference_in_differences(treated_pre, treated_post, comparison_pre, comparison_post) -%}\n    (({{ treated_post }}) - ({{ treated_pre }}))\n    - (({{ comparison_post }}) - ({{ comparison_pre }}))\n{%- endmacro %}"
    },
    {
      "name": "review_hours",
      "path": "macros/review_hours.sql",
      "description": "Whole hours between submission and review, so every model measures review time the same way.",
      "arguments": [
        "start_time",
        "end_time"
      ],
      "sql": "{% macro review_hours(start_time, end_time) %}\n    date_diff('hour', {{ start_time }}, {{ end_time }})\n{% endmacro %}"
    },
    {
      "name": "safe_ratio",
      "path": "macros/safe_ratio.sql",
      "description": "Divides two expressions and returns null instead of failing when the denominator is zero.",
      "arguments": [
        "numerator",
        "denominator"
      ],
      "sql": "{% macro safe_ratio(numerator, denominator) -%}\n    ({{ numerator }}) * 1.0 / nullif(({{ denominator }}), 0)\n{%- endmacro %}"
    },
    {
      "name": "test_non_negative",
      "path": "macros/non_negative.sql",
      "description": "Generic data test that fails on any negative value in a column.",
      "arguments": [
        "model",
        "column_name"
      ],
      "sql": "{% test non_negative(model, column_name) %}\nselect *\nfrom {{ model }}\nwhere {{ column_name }} < 0\n{% endtest %}"
    },
    {
      "name": "wilson_score_bound",
      "path": "macros/wilson_score_bound.sql",
      "description": "Lower or upper Wilson score bound for a proportion. Algebra only; it is a valid interval only under a defensible sampling design.",
      "arguments": [
        "proportion",
        "trials",
        "side",
        "z"
      ],
      "sql": "{% macro wilson_score_bound(proportion, trials, side, z=1.96) -%}\n    {% if side not in ['lower', 'upper'] %}\n        {{ exceptions.raise_compiler_error(\"wilson_score_bound side must be 'lower' or 'upper'\") }}\n    {% endif %}\n    (\n        case when ({{ trials }}) > 0 then\n            (\n                ({{ proportion }}) + ({{ z }} * {{ z }}) / (2.0 * ({{ trials }}))\n                {{ '-' if side == 'lower' else '+' }}\n                {{ z }} * sqrt(\n                    ({{ proportion }}) * (1.0 - ({{ proportion }})) / ({{ trials }})\n                    + ({{ z }} * {{ z }}) / (4.0 * ({{ trials }}) * ({{ trials }}))\n                )\n            ) / (1.0 + ({{ z }} * {{ z }}) / ({{ trials }}))\n        end\n    )\n{%- endmacro %}"
    }
  ]
